{
  "name": "piclist",
  "version": "2.4.2",
  "description": "Modified PicGo core, A tool for picture uploading",
  "keywords": [
    "picture",
    "upload",
    "util"
  ],
  "homepage": "https://piclist.cn",
  "bugs": {
    "url": "https://github.com/Kuingsmile/PicList-core/issues",
    "email": "pkukuing@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/PicList-Core.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kuingsmile",
    "email": "pkukuing@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "picgo": "./bin/picgo",
    "picgo-server": "./bin/picgo-server"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rimraf ./dist && rollup -c rollup.config.js",
    "cz": "git-cz",
    "dev": "cross-env NODE_ENV=development rollup -c rollup.config.js -w",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "lint:dpdm": "dpdm -T --tsconfig ./tsconfig.json --no-tree --no-warning --exit-code circular:1 src/index.ts",
    "prepare": "husky",
    "publish:npm": "cross-env NODE_ENV=production rimraf ./dist && rollup -c rollup.config.js && npm publish",
    "release": "bump-version",
    "server": "node ./bin/picgo-server",
    "start": "node ./bin/picgo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node test/package/check.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.11.24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/lib-storage": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@inquirer/prompts": "^8.7.2",
    "@piclist/i18n": "^3.0.0",
    "@piclist/store": "^4.0.0",
    "@smithy/node-http-handler": "4.12.1",
    "axios": "^1.20.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "file-type": "22.1.0",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.0",
    "heic-convert": "^2.1.0",
    "hpagent": "1.2.0",
    "image-size": "^2.0.4",
    "ink": "^7.1.1",
    "is-wsl": "^3.1.1",
    "js-yaml": "^5.4.2",
    "lodash-es": "^4.18.1",
    "mime": "4.1.0",
    "minimist": "^1.2.8",
    "multer": "^2.4.0",
    "node-ssh-no-cpu-features": "^2.0.0",
    "qiniu": "7.15.2",
    "react": "^19.2.0",
    "resolve": "^1.22.12",
    "sharp": "0.34.4",
    "string-width": "^8.2.0",
    "text-to-svg": "^3.1.5",
    "tunnel": "^0.0.6",
    "ulid": "^3.0.2",
    "uuid": "^14.0.2",
    "webdav": "^5.10.0",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/heic-convert": "^2.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/resolve": "^1.20.6",
    "@types/text-to-svg": "^3.1.4",
    "@types/tunnel": "^0.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "dpdm": "^4.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^75.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "node-bump-version": "^3.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "4.62.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-string": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bumpVersion": {
    "preset": "emoji"
  },
  "picBed": {
    "current": "smms"
  },
  "plugins": {}
}
