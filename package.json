{
  "name": "piclist",
  "version": "3.0.2",
  "description": "Modified PicGo core, A tool for picture uploading",
  "keywords": [
    "picture",
    "upload",
    "util"
  ],
  "homepage": "https://piclist.cn",
  "bugs": {
    "url": "https://github.com/Kuingsmile/PicList-core/issues",
    "email": "pkukuing@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/PicList-Core.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kuingsmile",
    "email": "pkukuing@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "picgo": "./bin/picgo",
    "picgo-server": "./bin/picgo-server"
  },
  "scripts": {
    "build": "rimraf ./dist && cross-env NODE_ENV=production rolldown -c rolldown.config.js",
    "cz": "czg --config=.cz-config.cjs",
    "dev": "cross-env NODE_ENV=development rolldown -c rolldown.config.js -w",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "lint:dpdm": "dpdm -T --tsconfig ./tsconfig.json --no-tree --no-warning --exit-code circular:1 src/index.ts",
    "prepare": "husky",
    "publish:npm": "pnpm run build && pnpm publish",
    "release": "bump-version",
    "server": "node ./bin/picgo-server",
    "start": "node ./bin/picgo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@inquirer/prompts": "^8.8.0",
    "@piclist/i18n": "^3.0.0",
    "@piclist/store": "^4.0.0",
    "@smithy/node-http-handler": "^4.14.2",
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "file-type": "^22.3.0",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1",
    "heic-convert": "^2.1.0",
    "hpagent": "^1.2.0",
    "image-size": "^2.1.0",
    "ink": "^8.0.0",
    "is-wsl": "^3.1.1",
    "js-yaml": "^5.5.0",
    "lodash-es": "^4.18.1",
    "mime": "4.1.2",
    "minimist": "^1.2.8",
    "multer": "^2.5.0",
    "node-ssh-no-cpu-features": "^2.0.0",
    "qiniu": "^7.15.2",
    "react": "^19.3.1",
    "resolve": "^1.22.14",
    "sharp": "0.35.5",
    "string-width": "^9.0.0",
    "text-to-svg": "^3.1.5",
    "tunnel": "^0.0.6",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3",
    "webdav": "^5.11.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/heic-convert": "^2.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/resolve": "^1.20.6",
    "@types/ssh2": "^1.15.6",
    "@types/text-to-svg": "^3.1.4",
    "@types/tunnel": "^0.0.7",
    "cross-env": "^10.1.0",
    "czg": "^1.14.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "node-bump-version": "^3.1.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rolldown": "1.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "bundledDependencies": [
    "webdav"
  ],
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bumpVersion": {
    "preset": "emoji"
  },
  "picBed": {
    "current": "smms"
  },
  "plugins": {}
}
