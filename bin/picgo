#!/usr/bin/env node
import { homedir } from 'node:os'
import { resolve } from 'node:path'

import minimist from 'minimist'

import { PicGo } from '../dist/index.js'

const argv = minimist(process.argv.slice(2), {
  alias: {
    c: 'config',
  },
  string: ['c', 'config'],
})

function resolveConfigPath(value) {
  if (typeof value !== 'string' || value.length === 0) {
    return ''
  }

  // Expand "~" only when it represents the home directory.
  return resolve(value.replace(/^~(?=$|[\\/])/, homedir()))
}

const configPath = resolveConfigPath(argv.config)
const picgo = await PicGo.create(configPath)

picgo.registerCommands()

const isInteractiveTerminal = () => Boolean(process.stdin.isTTY && process.stdout.isTTY)

async function openTui() {
  if (!isInteractiveTerminal()) {
    throw new Error('The TUI requires an interactive terminal. Use picgo --help for command-line usage.')
  }
  const { startTui } = await import('../dist/tui.js')
  await startTui(picgo)
}

const { program } = picgo.cmd

program.command('tui').description(picgo.i18n.t('CLI_TUI')).action(openTui)
program.action(async () => {
  if (isInteractiveTerminal() && !picgo.getConfig('silent')) {
    await openTui()
    return
  }

  program.outputHelp()
})

try {
  await program.parseAsync(process.argv)
} catch (e) {
  console.error(e instanceof Error ? e.message : 'Unable to start PicList.')
  process.exitCode = 1
}
